# Kiln (Bricksum) key for pcp/kiln.py. Without it, document readings become HOLD (never APPROVE)
# and expense rules must be written with the form instead of words. The key draws on the team's
# shared budget: check it with `python3 -m pcp spend`. Budget guards (KILN_RUN_CAP_USD,
# KILN_BUDGET_USD, KILN_KEY_STOP_USD) and KILN_MODEL are read from the process environment.
KILN_API_KEY=

# Legacy contract deploy only (script/Deploy.s.sol, Base Sepolia). The app does not use it.
# ESCROW_AGENT is the address of the backend signer allowed to record decisions.
ESCROW_AGENT=
PRIVATE_KEY=
