# Kiln. Leave KILN_API_KEY empty to run the mock client.
# Mock responses are not Kiln evidence.
KILN_BASE_URL=https://api.bricksum.com/v1
KILN_API_KEY=
KILN_MODEL=qwen3-32b
KILN_MODE=mock

# Backend
PORT=3010
DATABASE_PATH=backend/data/smartescrow.db

# Base Sepolia. Leave the contract addresses empty to skip chain writes.
RPC_URL=https://sepolia.base.org
CHAIN_ID=84532
ESCROW_ADDRESS=
USDC_ADDRESS=
AGENT_PRIVATE_KEY=
CLIENT_PRIVATE_KEY=

# Foundry deploy. ESCROW_AGENT is the address of AGENT_PRIVATE_KEY.
ESCROW_AGENT=
PRIVATE_KEY=

# Monad testnet (chain 10143) for the PCP escrow demo: test keys only (escrow/chain_monad.py, script/deploy_monad.py)
MONAD_RPC=https://testnet-rpc.monad.xyz
DEPLOYER_KEY=
DEPLOYER_ADDRESS=
RELAYER_KEY=
RELAYER_ADDRESS=
