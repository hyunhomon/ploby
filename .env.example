# Kiln (Bricksum) key for pcp/kiln.py. Without it, document readings become HOLD (never APPROVE)
# and expense rules must be written with the form instead of words. The key draws on the team's
# shared budget: check it with `python3 -m pcp spend`. Budget guards (KILN_RUN_CAP_USD,
# KILN_BUDGET_USD, KILN_KEY_STOP_USD) and KILN_MODEL are read from the process environment.
KILN_API_KEY=

# Base Sepolia ExpenseEscrow. Leave the addresses empty and the app stays off chain.
# CLIENT_PRIVATE_KEY creates and funds the project and approves or rejects HOLDs.
# AGENT_PRIVATE_KEY records decisions and releases. 1 policy unit = 1 MockUSDC (6 decimals).
RPC_URL=https://sepolia.base.org
CHAIN_ID=84532
ESCROW_ADDRESS=
USDC_ADDRESS=
AGENT_PRIVATE_KEY=
CLIENT_PRIVATE_KEY=

# Foundry deploy only. ESCROW_AGENT is the address of AGENT_PRIVATE_KEY.
ESCROW_AGENT=
PRIVATE_KEY=
